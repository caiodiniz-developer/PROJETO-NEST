@baseUrl = http://localhost:3333
@authToken = {{authenticate.response.body.access_token}}
@questionId = {{fetch_recent_questions.response.body.$.questions[0].id}}
@answerId = {{fetch_question_answers.response.body.$.answers[0].id}}

# @name create_account
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "name": "John Doe",
  "email": "johndoe@example.com",
  "password": "123456"
}

###

# @name authenticate
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "email": "johndoe@example.com",
  "password": "123456"
}

###

# @name create_question
POST {{baseUrl}}/questions
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Nova pergunta",
  "content": "Conteúdo da pergunta"
}

###

# @name fetch_recent_questions
GET {{baseUrl}}/questions?page=1
Content-Type: application/json
Authorization: Bearer {{authToken}}

###

# @name get_question_by_slug
GET {{baseUrl}}/questions/nova-pergunta
Authorization: Bearer {{authToken}}

###

# @name edit_question
PUT {{baseUrl}}/questions/{{questionId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Pergunta editada",
  "content": "Conteúdo editado"
}

###

# @name delete_question
DELETE {{baseUrl}}/questions/{{questionId}}
Authorization: Bearer {{authToken}}

###

# @name answer_question
POST {{baseUrl}}/questions/{{questionId}}/answers
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "content": "Nova resposta"
}

###

# @name fetch_question_answers
GET {{baseUrl}}/questions/{{questionId}}/answers?page=1
Authorization: Bearer {{authToken}}

###

# @name edit_answer
PUT {{baseUrl}}/answers/{{answerId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "content": "Resposta editada"
}

###

# @name choose_question_best_answer
PATCH {{baseUrl}}/answers/{{answerId}}/choose-as-best
Authorization: Bearer {{authToken}}

###

# @name delete_answer
DELETE {{baseUrl}}/answers/{{answerId}}
Authorization: Bearer {{authToken}}
